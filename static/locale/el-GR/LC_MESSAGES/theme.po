msgctxt "button"
msgid "See all plans"
msgstr "Δείτε όλα τα προγράμματα"

#: sections/pricing.twig:161
msgid "Not ready to pay? Try the free plan"
msgstr "Δεν είστε έτοιμοι να πληρώσετε; Δοκιμάστε το δωρεάν πρόγραμμα"

#: sections/speech-to-text.twig:4
msgid "Speech to text"
msgstr "Ομιλία σε κείμενο"

#: sections/speech-to-text.twig:8
msgctxt "heading"
msgid "Turn recordings into text."
msgstr "Μετατρέψτε τις ηχογραφήσεις σε κείμενο."

#: sections/speech-to-text.twig:12
msgid "Upload a meeting, interview or voice note and get a transcript you can copy and download."
msgstr "Ανεβάστε μια σύσκεψη, μια συνέντευξη ή μια φωνητική σημείωση και λάβετε μια απομαγνητοφώνηση που μπορείτε να αντιγράψετε και να κατεβάσετε."

#: sections/speech-to-text.twig:16
msgctxt "button"
msgid "Transcribe audio"
msgstr "Απομαγνητοφώνηση ήχου"

#: sections/text-to-voice.twig:4
msgid "Text to speech"
msgstr "Μετατροπή κειμένου σε ομιλία"

#: sections/text-to-voice.twig:8
msgctxt "heading"
msgid "Give your words a natural voice."
msgstr "Δώστε στις λέξεις σας φυσική φωνή."

#: sections/text-to-voice.twig:12
msgid "Pick a lifelike voice for narration, videos and podcasts."
msgstr "Επιλέξτε μια ρεαλιστική φωνή για αφήγηση, βίντεο και podcast."

#: sections/video.twig:11
msgid "AI video"
msgstr "Βίντεο AI"

#: sections/video.twig:15
msgctxt "heading"
msgid "Make short videos from a prompt or a photo."
msgstr "Δημιουργήστε σύντομα βίντεο από μια προτροπή ή μια φωτογραφία."

#: sections/video.twig:19
msgid "No editing skills needed. Write a few lines, add an image if you like, and the AI does the rest."
msgstr "Δεν χρειάζονται δεξιότητες επεξεργασίας. Γράψτε λίγες γραμμές, προσθέστε μια εικόνα αν θέλετε και η AI αναλαμβάνει τα υπόλοιπα."

#: sections/video.twig:23
msgctxt "button"
msgid "Make a video"
msgstr "Δημιουργία βίντεο"

#: sections/writer.twig:22
#: snippets/plan-rows.twig:103
msgid "AI writer"
msgstr "Συγγραφή με AI"

#: sections/writer.twig:26
msgctxt "heading"
msgid "Blog posts, emails and ads, written in minutes."
msgstr "Άρθρα ιστολογίου, email και διαφημίσεις σε λίγα λεπτά."

