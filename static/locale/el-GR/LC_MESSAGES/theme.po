#: sections/pricing.twig:127
msgid "Extra credits on top of your plan."
msgstr "Επιπλέον μονάδες πέρα από το πρόγραμμά σας."

#: sections/pricing.twig:135
msgctxt "button"
msgid "Start :days-day free trial"
msgstr "Ξεκινήστε δωρεάν δοκιμή :days ημερών"

