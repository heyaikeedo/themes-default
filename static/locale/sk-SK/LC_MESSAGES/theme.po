msgctxt "heading"
msgid "Chat with your documents"
msgstr "Chatujte so svojimi dokumentmi"

#: sections/features.twig:26
msgid "Upload files and ask questions about them. Answers come from your own content."
msgstr "Nahrajte súbory a pýtajte sa na ich obsah. Odpovede vychádzajú z vášho vlastného obsahu."

