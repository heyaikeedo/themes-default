<div class="relative wrapper enter" id="image-generator">
	<div class="flex relative z-10 items-center lg:w-1/2">
		<div class="px-12 py-12 w-full max-w-xl md:py-40">
			<div class="badge">
				{{ d__('theme', 'AI images') }}
			</div>

			<h3 class="mt-8">
				{{ dp__('theme', 'heading', 'Turn a sentence into an image.') }}
			</h3>

			<p class="mt-3 font-medium md:mt-6 md:text-xl">
				{{ d__('theme', 'Describe what you want to see, pick a model, and get images you can download and reuse.') }}
			</p>

			<div class="mt-8 md:mt-10">
				{% include "@theme/snippets/cta-link.twig" with {path: '/app/imagine', label: dp__('theme', 'button', 'Create an image')} %}
			</div>
		</div>
	</div>

	{# Four columns of example images scrolling up and down. Each column
	   lists its images twice and moves by exactly one list, so the loop has
	   no seam; the gap between images matches the gap between columns. #}
	<div class="absolute top-0 right-0 w-full h-full overflow-hidden rounded-3xl lg:rounded-l-none lg:w-1/2" aria-hidden="true">
		<div class="grid grid-cols-4 gap-4 px-4 lg:pl-0 preview">
			{% for col in 1..4 %}
			<div class="gallery-col">
				<div class="gallery-track">
					{% for copy in 1..2 %}
					<div class="gallery-set">
						{% for i in 1..4 %}
						<img src="{{ ('/assets/gallery/' ~ col ~ '-' ~ i ~ '.webp') | asset_url }}" alt="" decoding="async"
							width="320" height="{{ col is even ? 427 : 320 }}">
						{% endfor %}
					</div>
					{% endfor %}
				</div>
			</div>
			{% endfor %}
		</div>
	</div>
</div>
