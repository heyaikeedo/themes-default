<div class="grid md:grid-cols-2 wrapper enter">
	<div class="flex items-center p-4 md:pl-0 md:pr-6 md:order-2">
		<img src="{{ '/assets/chat.webp' | asset_url }}" alt="AI Chat Bot" class="dark:hidden" width="1410" height="1198">

		<img src="{{ '/assets/chat-dark.webp' | asset_url }}" alt="AI Chat Bot" class="hidden dark:block" width="1411" height="1198">
	</div>

	<div class="flex items-center">
		<div class="p-12 w-full max-w-xl">
			<span class="badge">
				{{ d__('theme', 'AI chat') }}
			</span>

			<h3 class="mt-8">
				{{ dp__('theme', 'heading', 'Ask anything. Get clear, useful answers.') }}
      </h3>

      <p class="mt-3 font-medium md:mt-6 md:text-xl">
        {{ d__('theme', 'Chat with leading AI models to brainstorm, research, write and solve problems faster.') }}
      </p>

      <div class="mt-8 md:mt-14">
        {% include "@theme/snippets/cta-link.twig" with {path: '/app/chat', label: dp__('theme', 'button', 'Start chatting')} %}
      </div>
    </div>
  </div>
</div>
