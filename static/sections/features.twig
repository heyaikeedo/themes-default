{#
  What the app offers beyond the showcased tools. Each card shows only when
  the admin has switched its feature on.
#}
{% set f = option.features ?? {} %}
{% set chat = f.chat.is_enabled ?? false %}
{% set enabled_locales = (locales ?? [])|filter(l => l.enabled ?? false) %}

{% set cards = [
  {
    show: models is defined and models|length > 0,
    icon: 'brain',
    title: dp__('theme', 'heading', 'Leading AI models'),
    text: d__('theme', 'Use models from several AI providers in one app, without separate accounts.')
  },
  {
    show: chat and (f.chat.custom_assistants.is_enabled ?? false),
    icon: 'robot',
    title: dp__('theme', 'heading', 'Custom assistants'),
    text: d__('theme', 'Build assistants with their own instructions and knowledge, and reuse them any time.')
  },
  {
    show: chat and (f.tools.embedding_search.is_enabled ?? false),
    icon: 'file-text-ai',
    title: dp__('theme', 'heading', 'Chat with your documents'),
    text: d__('theme', 'Upload files and ask questions about them. Answers come from your own content.')
  },
  {
    show: chat and (f.tools.web_search.is_enabled ?? false),
    icon: 'world-search',
    title: dp__('theme', 'heading', 'Live web search'),
    text: d__('theme', 'Get answers that draw on up-to-date information from the web.')
  },
  {
    show: chat and (f.tools.connectors.is_enabled ?? false),
    icon: 'plug-connected',
    title: dp__('theme', 'heading', 'Connect your apps'),
    text: d__('theme', 'Bring the tools you already use into the conversation.')
  },
  {
    show: chat and (f.routines.is_enabled ?? false),
    icon: 'clock-play',
    title: dp__('theme', 'heading', 'Scheduled tasks'),
    text: d__('theme', 'Let the AI handle reminders, recurring reports and ongoing updates on a schedule.')
  },
  {
    show: f.private_mode.is_enabled ?? false,
    icon: 'eye-off',
    title: dp__('theme', 'heading', 'Private mode'),
    text: d__('theme', 'What you create in private mode stays out of your history and library, and is deleted automatically.')
  },
  {
    show: true,
    icon: 'users',
    title: dp__('theme', 'heading', 'Built for teams'),
    text: d__('theme', 'Invite your teammates to a shared workspace and work from the same plan.')
  },
  {
    show: true,
    icon: 'books',
    title: dp__('theme', 'heading', 'Your library'),
    text: d__('theme', 'Everything you create is saved in one place, ready to find, reuse and download.')
  },
  {
    show: enabled_locales|length > 1,
    icon: 'language',
    title: dp__('theme', 'heading', 'Speaks your language'),
    text: d__('theme', 'Use the app in the language you are most comfortable with.')
  },
  {
    show: option.color_scheme.modes is not defined or option.color_scheme.modes|length > 1,
    icon: 'moon',
    title: dp__('theme', 'heading', 'Light and dark mode'),
    text: d__('theme', 'Work the way your eyes prefer, day or night.')
  },
  {
    show: plans is defined and plans|length > 0,
    icon: 'lock',
    title: dp__('theme', 'heading', 'Secure checkout'),
    text: d__('theme', 'Pay safely through trusted payment providers and manage your plan any time.')
  }
]|filter(card => card.show) %}

<section id="features" class="scroll-mt-10">
  <h2 class="text-center enter">
    {{ dp__('theme', 'heading', 'Everything in one workspace') }}
  </h2>

  <div class="grid gap-6 mt-6 sm:grid-cols-2 md:gap-10 md:mt-10 lg:grid-cols-3">
    {% for card in cards %}
    <div class="p-8 wrapper enter3">
      <span class="icon shadow-right">
        <i class="ti ti-{{ card.icon }}"></i>
      </span>

      <h3 class="mt-10 lg:text-2xl">{{ card.title }}</h3>
      <p class="mt-4 font-medium md:text-lg text-secondary">{{ card.text }}</p>
    </div>
    {% endfor %}
  </div>
</section>
