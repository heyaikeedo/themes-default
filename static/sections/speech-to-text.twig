<div class="flex flex-col justify-between wrapper">
	<div class="p-12">
		<span class="badge">
			{{ d__('theme', 'Speech to text') }}
		</span>

		<h3 class="mt-8">
			{{ dp__('theme', 'heading', 'Turn recordings into text.') }}
		</h3>

		<p class="mt-3 font-medium md:mt-6 md:text-xl">
			{{ d__('theme', 'Upload a meeting, interview or voice note and get a transcript you can copy and download.')  }}
		</p>

		<div class="mt-8 md:mt-10">
			{% include "@theme/snippets/cta-link.twig" with {path: '/app/transcriber', label: dp__('theme', 'button', 'Transcribe audio')} %}
		</div>
	</div>

	<div class="mx-0.5">
		<img src="{{ '/assets/speech-to-text.webp' | asset_url }}" alt="AI speech to text transformer" class="dark:hidden" width="1138" height="1046">
		<img src="{{ '/assets/speech-to-text-dark.webp' | asset_url }}" alt="AI speech to text transformer" class="hidden dark:block" width="1138" height="1046">
	</div>
</div>
