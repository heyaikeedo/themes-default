{# The closing call to action: the same hairline card as the rest of the page,
   with the admin's accent colour only as a soft glow from the bottom edge. #}
<section class="relative overflow-hidden text-center border rounded-3xl bg-contrast-primary border-line-secondary dark:border-line-tertiary enter">
  {# Softer in dark mode, where a strong glow muddies the accent. #}
  <div class="absolute left-1/2 -bottom-[120%] w-[180%] h-[200%] -translate-x-1/2 pointer-events-none [--cta-glow:0.7] dark:[--cta-glow:0.22]"
    style="background: radial-gradient(closest-side, rgb(var(--color-contrast-accent) / var(--cta-glow)), transparent)"></div>

  <div class="relative px-6 py-12 md:p-16">
    {% if user is defined %}
    <h2>{{ dp__('theme', 'heading', 'Pick up where you left off') }}</h2>
    <p class="max-w-xl mx-auto mt-3 md:text-lg text-secondary">
      {{ d__('theme', 'Your chats, documents and media are waiting in your workspace.') }}
    </p>
    {% else %}
    <h2>{{ dp__('theme', 'heading', 'Ready to get started?') }}</h2>
    <p class="max-w-xl mx-auto mt-3 md:text-lg text-secondary">
      {{ d__('theme', 'Create your account and put AI to work in minutes.') }}
    </p>
    {% endif %}

    <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
      <a href="{{ user is defined ? '/app' : '/signup' }}" class="gap-2 rounded-full button button-primary">
        {{ user is defined ? dp__('theme', 'button', 'Go to app') : dp__('theme', 'button', 'Get started') }}
        <i class="text-lg ti ti-arrow-right"></i>
      </a>

      {% if (plans ?? [])|length > 0 %}
      <a href="/#pricing" class="rounded-full button button-outline">
        {{ dp__('theme', 'button', 'See pricing') }}
      </a>
      {% endif %}
    </div>
  </div>
</section>
