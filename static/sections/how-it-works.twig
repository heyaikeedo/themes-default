{% set steps = [
  ['user-plus', dp__('theme', 'heading', 'Create your account'), d__('theme', 'Sign up in seconds and land on your own dashboard.')],
  ['apps', dp__('theme', 'heading', 'Pick a tool and a model'), d__('theme', 'Chat, write, create images and more. Choose the AI model that suits the job.')],
  ['sparkles', dp__('theme', 'heading', 'Describe it, get results'), d__('theme', 'Say what you need in plain words, refine the result, and find it later in your library.')]
] %}

<section>
  <h2 class="text-center enter">
    {{ dp__('theme', 'heading', 'How it works') }}
  </h2>

  <div class="grid gap-6 mt-6 md:gap-10 md:mt-10 lg:grid-cols-3">
    {% for step in steps %}
    <div class="p-8 wrapper enter3">
      <div class="flex items-center justify-between">
        <span class="icon shadow-right">
          <i class="ti ti-{{ step[0] }}"></i>
        </span>
        <span class="text-5xl font-bold text-line-secondary">{{ loop.index }}</span>
      </div>

      <h3 class="mt-10 lg:text-2xl">{{ step[1] }}</h3>
      <p class="mt-4 font-medium md:text-lg text-secondary">{{ step[2] }}</p>
    </div>
    {% endfor %}
  </div>
</section>
